# ============================================================
#  模型服务配置
#  复制本文件为 .env，填入你自己的 key，然后运行：
#      python scripts/check_key.py
#  .env 已被 .gitignore 排除，不会进入仓库。
# ============================================================

# ---- 方案 A：DeepSeek（流程最短，建议先用这个）----
# 注册 https://platform.deepseek.com  → 充值 10 元 → 创建 API key
GEO_API_BASE=https://api.deepseek.com
GEO_API_KEY=
GEO_MODEL=deepseek-flash

# ---- 方案 B：阿里云百炼（有新人免费额度，愿意折腾可以用）----
# 控制台 https://bailian.console.aliyun.com  → 开通（华北2 北京）→ API-KEY 管理
# GEO_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# GEO_API_KEY=
# GEO_MODEL=qwen-plus

# ---- 方案 C：联通元景 / 上海智慧教育平台（等组委会开放后填这里）----
# 除 base 与 model 外，其余代码不需要改动。
# GEO_API_BASE=
# GEO_API_KEY=
# GEO_MODEL=
